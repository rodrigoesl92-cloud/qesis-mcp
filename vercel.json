{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    },
    {
      "src": "STIR_Governance_Dashboard.html",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/mcp",
      "destination": "/api/index.py"
    },
    {
      "src": "/(.*)",
      "destination": "/STIR_Governance_Dashboard.html"
    }
  ]
}
