{
  "version": 2,
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.py"
    },
    {
      "src": "/mcp",
      "dest": "/api/index.py"
    }
  ],
  "headers": [
    {
      "source": "/(.*\\.(js|css|map|png|jpg|jpeg|svg|webp|woff2|woff|ttf))",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}