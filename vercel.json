{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/mcp",
      "destination": "/api/index.py"
    }
  ],
  "headers": [
    {
      "source": "/(.*\\.(js|css|map|png|jpg|jpeg|svg|webp|woff2|woff|ttf))",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
