# L-063: this repository is reachable from Windows and from a Linux analysis
# mount. Without normalisation the worktree flips between dirty and clean
# depending on which operating system wrote last, and a genuine change will
# eventually arrive hidden inside a whole-file no-op diff.
* text=auto eol=lf

*.png  binary
*.jpg  binary
*.pdf  binary
*.xlsx binary
*.sqlite binary
*.ps1  text eol=crlf
*.bat  text eol=crlf
