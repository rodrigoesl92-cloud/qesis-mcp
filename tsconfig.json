{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "lib": ["DOM","ES2022"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "moduleResolution": "Node",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "types": ["node"]
  },
  "include": ["**/*"],
  "exclude": ["node_modules"]
}
